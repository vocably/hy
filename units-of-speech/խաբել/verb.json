{"transcript":"χɑbɛl","exists":true,"definitions":["Մեկին մոլորության մեջ գցել՝ սուտ խոսքերով կամ արարքներով։","Խաբեությամբ մեկից որևէ բան վերցնել կամ ձեռք բերել։","Հուսախաբ անել, սպասելիքները չարդարացնել։"],"examples":["Նա փորձեց ինձ խաբել։","Մի խաբիր ուրիշներին։","Խոստումները խաբեցին նրան։"],"lemma":"խաբել","lemmaPos":"verb","synonyms":["մոլորեցնել","խաբեբայություն անել","ստել"],"number":"singular","tense":"present","source":"խաբել"}